# .env.example — copy to `.env` and fill in. NEVER commit the real `.env`.
# Match-ZeroBaran runs with ZERO keys (template brain), so everything here is optional.

# --- behaviour ---------------------------------------------------------------
MZB_LANG=ar                 # ar | en
MZB_TOP_K=3                 # recommendations per customer
MZB_TIMEOUT=12

# --- AI copywriting (pick ONE — both have free tiers) ------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# --- delivery ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional cloud persistence (Supabase free tier) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=